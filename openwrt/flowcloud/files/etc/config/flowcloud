config settings 'settings'
	# Off until configured in LuCI (Services > FlowCloud): enabling takes over
	# dnsmasq's upstream DNS, which another service such as podkop may own.
	option enabled '0'
	option dnsmasq_integration '1'
	option dns_listen '127.0.0.53:53'
	list dns_upstream 'https://1.1.1.1/dns-query'
	list dns_upstream 'https://8.8.8.8/dns-query'
	option strip_aaaa '1'
	option update_interval '24h'
	list source_interfaces 'br-lan'
	option route_router_traffic '1'

config tunnel 'warp'
	option type 'warp'
	option device 'fcwarp'
	option health_interval '15'
	option fail_closed '0'

config section 'main'
	option enabled '1'
	option action 'tunnel'
	option tunnel 'warp'
	list community_lists 'youtube'
	list community_lists 'telegram'
	list community_lists 'discord'
	list community_lists 'meta'
	list community_lists 'twitter'

config zapret 'zapret'
	option enabled '1'
	option strategy 'auto'
	option check_interval '300'
	list test_url 'https://www.youtube.com/'
	list test_url 'https://i.ytimg.com/generate_204'
	list test_url 'https://redirector.googlevideo.com/report_mapping'
